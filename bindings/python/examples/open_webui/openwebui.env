# Open WebUI on TheStage models: chat, dictation (speech-to-text) and read-aloud (TTS).
# Load with `set -a; source openwebui.env; set +a` before `open-webui serve`.
# The server: `thestage-sdk serve` (http://127.0.0.1:8000/v1). From Docker use
# http://host.docker.internal:8000/v1 instead.

# Chat models: Open WebUI lists the server's /v1/models.
OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local
ENABLE_OLLAMA_API=False

# Dictation. Open WebUI converts browser recordings (Opus/WebM) to mp3 with ffmpeg.
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
AUDIO_STT_OPENAI_API_KEY=local
AUDIO_STT_MODEL=whisper-1

# Read aloud: mp3 from the server's --tts model.
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
AUDIO_TTS_OPENAI_API_KEY=local
AUDIO_TTS_MODEL=tts-1
AUDIO_TTS_VOICE=dave

# No built-in tools: Open WebUI adds ~10 tool schemas (time, memory, knowledge, …) to
# every browser chat, more than a small on-device model's context holds, and the replies
# come back empty. Applies to a new DATA_DIR; for an existing install see the README.
DEFAULT_MODEL_METADATA={"capabilities": {"builtin_tools": false}}

# A single local user without sign-in: serve with --host 127.0.0.1. Remove for a
# shared install.
WEBUI_AUTH=False
